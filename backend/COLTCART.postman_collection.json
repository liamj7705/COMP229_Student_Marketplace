            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Calculus: Early Transcendentals 8th Ed\",\n  \"description\": \"Some highlighting, otherwise great\",\n  \"category\": \"textbook\",\n  \"price\": 45,\n  \"condition\": \"good\",\n  \"location\": \"Main campus library\",\n  \"courseCode\": \"MATH101\",\n  \"isbn\": \"9781285741550\"\n}"
            }
